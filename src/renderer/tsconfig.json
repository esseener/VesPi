{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out/renderer",
    "rootDir": "../..",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "composite": true,
    "declaration": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../shared/**/*.ts",
    "./src/themes/*.json",
    "../../resources/permission-rules.ts",
    "../../resources/permission-rules.test.ts"
  ]
}
